{
  "name": "pi-agent-web",
  "version": "0.1.0",
  "description": "Self-hosted personal Web Agent powered by the Pi coding agent SDK",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfar-z/bug-paw.git"
  },
  "bugs": {
    "url": "https://github.com/jfar-z/bug-paw/issues"
  },
  "homepage": "https://github.com/jfar-z/bug-paw#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7080",
    "start": "tsx src/server/main.ts",
    "build": "npm run build:web",
    "build:container": "npm run build:web && npm run check:bundle",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:integration": "vitest run tests/integration",
    "screenshot:crop": "node tools/screenshots/crop.mjs",
    "verify": "npm run typecheck && npm run check:architecture && npm test && npm run build:web && npm run check:bundle",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@extractus/article-extractor": "^8.1.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lancedb/lancedb": "^0.33.0",
    "croner": "^10.0.0",
    "fastify": "5.11.2",
    "highlight.js": "11.11.1",
    "jszip": "^3.10.1",
    "katex": "0.18.1",
    "lucide-react": "1.28.0",
    "mammoth": "^1.12.0",
    "mermaid": "11.16.1",
    "mime": "4.1.0",
    "pdf-parse": "^2.4.5",
    "playwright": "1.62.1",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.3",
    "tsx": "4.23.7",
    "typebox": "^1.3.7",
    "undici": "8.9.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}

# 核心部署 / Core deployment
BUG_PAW_BIND_ADDRESS=0.0.0.0
BUG_PAW_PORT=7080
# Grok 等 URL 型媒体接口读取本地附件时使用的无认证外部地址，例如 https://bugpaw.example.com
BUG_PAW_PUBLIC_ORIGIN=
BUG_PAW_TIMEZONE=Asia/Shanghai
BUG_PAW_DATA_DIR=./pi-agent-data
BUG_PAW_WHISPER_MODEL=base
BUG_PAW_WHISPER_CPUS=4.0
BUG_PAW_WHISPER_MEMORY=2g

# AIGC Agent 任务限流 / AIGC Agent task limits
BUG_PAW_AIGC_AGENT_MAX_ACTIVE_TASKS=20
BUG_PAW_AIGC_AGENT_MAX_ACTIVE_TASKS_PER_AGENT=5
BUG_PAW_AIGC_AGENT_MAX_HOURLY_TASKS_PER_AGENT=200
BUG_PAW_AIGC_AGENT_QUERY_INTERVAL_SECONDS=1

# 联网搜索专属 / Search-only
# 使用搜索组合前必须替换为空间外生成的强随机值。
# Generate a strong random value before enabling the search deployment.
SEARXNG_SECRET=
WEB_RESEARCH_TRUSTED_FAKE_IP_CIDRS=198.18.0.0/15
WEB_RESEARCH_EGRESS_PROFILES_FILE=./config/web-research-egress-profiles.json

# 托管向量服务专属 / Managed embedding-only
BUG_PAW_EMBEDDING_CPUS=2.0

# 自托管浏览器执行 / Self-hosted browser automation
BUG_PAW_BROWSER_TRUSTED_FAKE_IP_CIDRS=
BUG_PAW_BROWSER_CPUS=2.0
BUG_PAW_BROWSER_MEMORY=2g
